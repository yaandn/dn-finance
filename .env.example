# Copie para .env.local e preencha. Este arquivo nunca deve ir para o git.

# Chaves da API Belvo (dashboard da Belvo → Developers → API Keys)
BELVO_SECRET_ID=
BELVO_SECRET_PASSWORD=

# sandbox (dados de teste da Belvo) ou production (dados reais)
BELVO_ENV=sandbox

# Opcional: IDs de links separados por vírgula. Se vazio, o app lista
# todos os links válidos da sua conta Belvo.
BELVO_LINK_IDS=

# Opcional: força a fonte de dados. belvo | file | demo
# Sem isso: usa a API se as chaves existirem; senão data/belvo-export.json;
# senão dados de demonstração.
# DATA_SOURCE=

# Copie para .env.local e preencha. Este arquivo nunca deve ir para o git.

# Supabase: login e dados de cada usuário (painel do projeto → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Só para o widget do Mac (ele não tem sessão de navegador): Settings → API Keys →
# Secret keys. Nunca use com o prefixo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Criptografa os tokens do Belvo de cada usuário no banco: openssl rand -base64 32
# Se trocar ou perder, cada pessoa precisa reconectar o Belvo Panorama.
TOKEN_ENCRYPTION_KEY=

# Chaves da API Belvo (dashboard da Belvo → Developers → API Keys)
BELVO_SECRET_ID=
BELVO_SECRET_PASSWORD=

# sandbox (dados de teste da Belvo) ou production (dados reais)
BELVO_ENV=sandbox

# Opcional: IDs de links separados por vírgula. Se vazio, o app lista
# todos os links válidos da sua conta Belvo.
BELVO_LINK_IDS=

# Opcional: força a fonte de dados. demo | belvo | file
# Sem isso: Belvo Panorama do usuário logado (se conectado) → dados de demonstração.
# "belvo" (chaves acima) e "file" (data/belvo-export.json) são de uma conta só
# e só funcionam em desenvolvimento, para não mostrar os mesmos dados a todos.
# DATA_SOURCE=

# Belvo Panorama via MCP (botão "Conectar Belvo Panorama" no app).
# Só mude se for testar com outro servidor.
# BELVO_MCP_URL=https://panorama-mcp.belvo.com/mcp
# Endereço público do app, usado no retorno do login (padrão: o da requisição)
# APP_URL=http://localhost:3000
